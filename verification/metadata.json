rnalType":"struct CapabilityRegistry.Profile","name":"","type":"tuple"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"string","name":"displayName","type":"string"},{"internalType":"string","name":"category","type":"string"},{"internalType":"bytes32","name":"endpointHash","type":"bytes32"}],"name":"register","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"uint256","name":"index","type":"uint256"}],"name":"registrantAt","outputs":[{"internalType":"address","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"registrantCount","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"bool","name":"paused_","type":"bool"}],"name":"setPaused","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[],"name":"totalCheckIns","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"totalRegistrants","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"address","name":"newOwner","type":"address"}],"name":"transferOwnership","outputs":[],"stateMutability":"nonpayable","type":"function"}],"devdoc":{"kind":"dev","methods":{},"title":"CapabilityRegistry \u2014 opt-in, self-registered capability profiles for Agent ID holders","version":1},"userdoc":{"kind":"user","methods":{"checkIn()":{"notice":"Check in as yourself. One check-in per holder per UTC day.         This is the single cheap interaction a holder makes to signal liveness."},"deregister()":{"notice":"Remove your own profile. Only the holder themselves can do this."},"profileOf(address)":{"notice":"Read a profile by holder address (address-keyed only; no name lookup exists)."},"register(string,string,bytes32)":{"notice":"Register your own capability profile. Caller must hold an Agent ID."}},"notice":"Design rules, by construction:         - Self-registration only: a wallet registers ITSELF, never another wallet.           There is deliberately no function to look up a wallet by name, and no           function that lets one address write another address's profile.         - Agent ID gated: registration and check-in require holding an Agent ID           in the official registry at the moment of the call.         - No custody: the contract holds no funds, has no payable functions, no           transfer, approval, or withdrawal logic of any kind.         - No credentials: profiles carry only what the holder chooses to publish           (a display name, a category, and a hash of an endpoint description).         Owner permissions (disclosed, per venue rules): the owner may pause and         unpause new registrations/check-ins, and transfer ownership. The owner         cannot edit or delete another holder's profile, cannot move funds         (none exist), and cannot change the Agent ID registry address.","version":1}},"settings":{"compilationTarget":{"CapabilityRegistry.sol":"CapabilityRegistry"},"evmVersion":"paris","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":200},"remappings":[]},"sources":{"AgentIDGate.sol":{"keccak256":"0x5d55657c8bfc59edf9852a1336cd655209b62ee85893218f4bb9777b169dba95","license":"MIT","urls":["bzz-raw://976cdf04cebdd8ed85e8152e1317aae59371892b20329abd324c3f4b749d3481","dweb:/ipfs/QmTPGnTnw37gT6EYsVnWaxtYFEdR6cC3ydq7rKqi5MgKxz"]},"CapabilityRegistry.sol":{"keccak256":"0x2087c37aa9c6135974c723a2ced4e95d3b5f333b7813c4081040046e24fab95f","license":"MIT","urls":["bzz-raw://228a46c7268f02f19c05d1c4e4aa967f74c674883619146435576f852d1452d8","dweb:/ipfs/Qmem4yMVcHSRqzuSi1SUmtwdNCKfVWmAMjTCxo2YqHdJcw"]}},"version":1}